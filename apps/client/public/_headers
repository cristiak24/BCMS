# Cloudflare static-asset headers (copied to dist/ by Vite).

# Vite bundles are content-hashed: safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Must revalidate on every load, or a deploy can be masked by a stale
# service worker / shell for days.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
