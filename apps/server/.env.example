# Copy this file to .env.local and fill in the values
RESEND_API_KEY=your-resend-api-key
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/dbname?sslmode=require
# FIREBASE_PROJECT_ID alone is enough to VERIFY client ID tokens (Firebase Admin
# validates them against Google's public JWKS — no credentials needed), so auth
# works on a bare local setup.
#
# READING FIRESTORE is different: it needs Application Default Credentials. Set
# EITHER the client-email + private-key pair below, OR
# FIREBASE_SERVICE_ACCOUNT_JSON, OR GOOGLE_APPLICATION_CREDENTIALS (path to a
# service-account JSON file). With none of them set, the routes that read
# Firestore skip it and fall back to Postgres, which is the supported local
# configuration — they must never 500 just because Firestore is unreachable.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternatives to the pair above (leave blank if using FIREBASE_CLIENT_EMAIL/KEY):
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
APP_BASE_URL=https://your-project-id.web.app
FRONTEND_URL=https://your-project-id.web.app
INVITE_EXPIRATION_MINUTES=10
PORT=3000
NODE_ENV=development
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CURRENCY=ron
# FRB (baskethotel) widget API key used by /api/basketball/*
FRB_API_KEY=your-frb-widget-api-key
