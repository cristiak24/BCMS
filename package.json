{
  "name": "bcms-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/server\" \"npm run start --workspace=apps/client\"",
    "build:web": "npm run build:web --workspace=apps/client",
    "deploy:firestore": "firebase deploy --only firestore",
    "seed:superadmin": "tsx scripts/seedSuperadmin.ts",
    "test": "npm run test --workspace=apps/server && npm run test --workspace=apps/client"
  },
  "devDependencies": {
    "ajv": "^6.15.0",
    "concurrently": "^8.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1"
  },
  "version": "1.0.0",
